#include <stdio.h>

int main() {
    int nums[5] = {3,2,6,1,4};
    int target = 5;

    for (int i = 0; i < 5; i++) {
        for (int j = i + 1; j < 5; j++) {
            if (nums[i] + nums[j] == target) {
                printf("[%d, %d]\n", i, j);
                return 0;
            }
        }
    }
}

#*CLOSEST NUMBER*# (21/7/26)

#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

int closestnumber(int n, int m)
{
    int closest = 0;
    int minDifference = INT_MAX;
    for (int i = n - abs(m); i <= n + abs(m); ++i)
    {
        if (i%m == 0)
        {
            int difference = abs (n - i);
            if (difference < minDifference || (difference == minDifference && abs(i) > abs(closest)))
            {
            closest = i;
            minDifference = difference;
            }
        }
    }
    return closest;
}

int main ()
{
    int num, multiple;
    scanf ("%d", &num);
    scanf ("%d", &multiple);
    printf ("%d\n", closestnumber(num, multiple));
    return 0;
}
